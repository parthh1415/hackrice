__pycache__/
*.xml
.env
tests/ui/node_modules/

# Cache is machine-local EXCEPT the golden recordings — those are the demo's
# insurance and insurance that lives in one uncommitted directory is not
# insurance. Note the parent must stay unexcluded: git cannot re-include a
# file whose parent directory is excluded, so `data/cache/` + `!.../golden/`
# silently does nothing.
data/cache/*
!data/cache/golden/

# dataset.json is "cache" only in the sense that we don't want to refetch it.
# It's 4KB of one frozen quarter's 13F holdings, and it is what every test and
# the whole demo actually runs on. Leaving it untracked meant a fresh clone had
# to reach EDGAR before a single test could pass — so the suite was green here
# and red everywhere else. Refresh it deliberately with scripts/refresh_dataset.py.
!data/cache/dataset.json
